# ===========================================
# Wattismoney - Variables de Entorno
# ===========================================
# Copia este archivo a .env y configura los valores

# ===========================================
# BASE DE DATOS (PostgreSQL)
# ===========================================
# Para desarrollo local con Docker:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# Para Supabase (recomendado):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Para NeonDB:
# DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# ===========================================
# AUTH.JS (NextAuth)
# ===========================================
# Genera un secret con: openssl rand -base64 32
AUTH_SECRET="tu-secret-super-seguro-aqui"

# URL de la aplicación (sin trailing slash)
AUTH_URL="http://localhost:3001"

# ===========================================
# GOOGLE OAUTH (Opcional)
# ===========================================
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# EMAIL (Resend - Para envío de emails)
# ===========================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=""

# ===========================================
# STORAGE (Supabase Storage - Para KYC)
# ===========================================
# Obtén estas credenciales en tu dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ===========================================
# APP URL (Para links en emails)
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ===========================================
# GEMINI AI (Para quiz de perfil de inversor)
# ===========================================
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

