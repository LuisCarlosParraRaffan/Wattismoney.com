# ===========================================
# Wattismoney - Variables de Entorno
# ===========================================
# Copia este archivo a .env y configura los valores

# ===========================================
# BASE DE DATOS (PostgreSQL)
# ===========================================
# Para desarrollo local con Docker:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# Para Supabase (recomendado):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Para NeonDB:
# DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# ===========================================
# AUTH.JS (NextAuth)
# ===========================================
# Genera un secret con: openssl rand -base64 32
AUTH_SECRET="tu-secret-super-seguro-aqui"

# URL de la aplicación (sin trailing slash)
AUTH_URL="http://localhost:3001"

# ===========================================
# GOOGLE OAUTH (Opcional)
# ===========================================
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# EMAIL (Para verificación - Futuro)
# ===========================================
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@wattismoney.com"

# ===========================================
# STORAGE (Para KYC - Futuro)
# ===========================================
# Para Supabase Storage:
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# Para Cloudinary:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
