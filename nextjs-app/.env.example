# ===========================================
# Wattismoney - Variables de Entorno
# ===========================================
# Copia este archivo a .env y configura los valores

# ===========================================
# BASE DE DATOS (PostgreSQL)
# ===========================================
# Para desarrollo local con Docker:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# Para Supabase (recomendado):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Para NeonDB:
# DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/wattismoney?schema=public"

# ===========================================
# AUTH.JS (NextAuth)
# ===========================================
# Genera un secret con: openssl rand -base64 32
AUTH_SECRET="tu-secret-super-seguro-aqui"

# URL de la aplicación (sin trailing slash)
AUTH_URL="http://localhost:3001"

# ===========================================
# GOOGLE OAUTH (Opcional)
# ===========================================
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# EMAIL (Resend - Para envío de emails)
# ===========================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=""

# ===========================================
# STORAGE (Supabase Storage - Para KYC)
# ===========================================
# Obtén estas credenciales en tu dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ===========================================
# APP URL (Para links en emails)
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ===========================================
# GEMINI AI (Para quiz de perfil de inversor)
# ===========================================
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ===========================================
# RIELES DE PAGO FIAT (Stripe + Pasarelas LATAM + Banco)
# ===========================================
# Stripe (Tarjetas Globales USD/EUR, Apple Pay, Google Pay, ACH)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Wompi / MercadoPago (PSE, Nequi, Bancolombia, SPEI)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""

# Cuenta Bancaria de Tesorería (Para Transferencias Directas)
NEXT_PUBLIC_TREASURY_BANK_NAME="Bancolombia / Mercury Bank USD"
NEXT_PUBLIC_TREASURY_BANK_ACCOUNT="912-0048291-01 (COP/USD) • SWIFT: COLOCOBM"
NEXT_PUBLIC_TREASURY_BENEFICIARY="Wattismoney Energy SPV S.A.S."

# ===========================================
# RIELES DE PAGO WEB3 / CRYPTO (USDC / USDT / ETH)
# ===========================================
# Billetera de Tesorería / Smart Contract Escrow (Polygon, Base, Arbitrum, Ethereum)
NEXT_PUBLIC_TREASURY_EVM_WALLET="0x71C95911E9a5D330f4D621842EC243EE1343292e"

# RPCs opcionales para verificación on-chain de txHash en el backend
POLYGON_RPC_URL="https://polygon-rpc.com"
BASE_RPC_URL="https://mainnet.base.org"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
ETHEREUM_RPC_URL="https://eth.llamarpc.com"


