// Wattismoney - Schema de Base de Datos
// Fase inicial: Registro, Autenticación y KYC
// Este schema es extensible para añadir más modelos en el futuro

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTENTICACIÓN (Compatible con Auth.js v5)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // Para login con credentials
  
  // Datos personales
  firstName     String?
  lastName      String?
  phone         String?
  dateOfBirth   DateTime?
  nationality   String?
  
  // Estado de la cuenta
  role          UserRole  @default(INVESTOR)
  status        UserStatus @default(PENDING_EMAIL_VERIFICATION)
  
  // Perfil de inversor (del quiz)
  investorProfile InvestorProfile?
  
  // Gamificación
  points        Int       @default(0)
  level         Int       @default(1)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relaciones
  accounts      Account[]
  sessions      Session[]
  kycDocuments  KycDocument[]
  investments   Investment[]
  
  // Índices para búsquedas frecuentes
  @@index([email])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// KYC (Know Your Customer)
// ============================================

model KycDocument {
  id            String          @id @default(cuid())
  userId        String
  
  // Tipo de documento
  documentType  DocumentType
  documentNumber String?
  
  // Archivos subidos
  frontImageUrl String?
  backImageUrl  String?
  selfieUrl     String?
  proofOfResidenceUrl String?
  
  // Estado de verificación
  status        KycStatus       @default(PENDING)
  rejectionReason String?
  
  // Metadata
  submittedAt   DateTime        @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?         // ID del admin que revisó
  expiresAt     DateTime?       // Fecha de expiración del documento
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model InvestorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  
  // Respuestas del quiz
  investmentGoal    String?  // "passive_income", "capital_growth", "diversification", "environmental_impact"
  investmentHorizon String?  // "less_1_year", "1_3_years", "3_5_years", "more_5_years"
  riskTolerance     String?  // "very_conservative", "conservative", "moderate", "aggressive"
  initialInvestment String?  // "less_1000", "1000_5000", "5000_20000", "more_20000"
  
  // Perfil calculado (legacy)
  profileType       ProfileType @default(MODERATE)
  
  // Perfil determinado por AI
  aiRiskProfile     String?   // "VISIONARIO" | "ACELERADOR" | "ESTABILIZADOR"
  aiConfidence      Float?    // 0.0 - 1.0
  aiReasons         String[]  // Array de razones
  aiRecommendations String[]  // Recomendaciones de inversión
  quizCompletedAt   DateTime?
  
  // Límites de inversión
  monthlyLimit      Decimal?    @db.Decimal(12, 2)
  
  // Preferencias
  preferredProjectTypes String[] // ["solar", "wind", "hydro", "biomass"]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  INVESTOR      // Usuario inversor normal
  ADMIN         // Administrador de la plataforma
  SUPER_ADMIN   // Super administrador
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION  // Recién registrado, email no verificado
  PENDING_KYC                 // Email verificado, KYC pendiente
  KYC_IN_REVIEW               // KYC enviado, en revisión
  KYC_REJECTED                // KYC rechazado
  ACTIVE                      // Usuario completamente verificado
  SUSPENDED                   // Cuenta suspendida
  DEACTIVATED                 // Cuenta desactivada por el usuario
}

enum KycStatus {
  PENDING     // Documentos no subidos
  SUBMITTED   // Documentos enviados, pendiente de revisión
  IN_REVIEW   // En proceso de revisión
  APPROVED    // Aprobado
  REJECTED    // Rechazado
  EXPIRED     // Documentos expirados
}

enum DocumentType {
  DNI         // Documento Nacional de Identidad (España)
  NIE         // Número de Identidad de Extranjero (España)
  PASSPORT    // Pasaporte
  DRIVERS_LICENSE
}

enum ProfileType {
  VERY_CONSERVATIVE
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// ============================================
// CONTRATOS / OPORTUNIDADES DE INVERSIÓN
// ============================================

model Contract {
  id              String          @id @default(cuid())
  
  // Información básica
  name            String          // Nombre del contrato
  description     String?         @db.Text
  imageUrl        String?         // Fotografía promocional
  
  // Rentabilidad
  annualReturn    Decimal         @db.Decimal(5, 2)  // Rentabilidad anual (%)
  
  // Límites de inversión
  minInvestment   Decimal         @db.Decimal(12, 2) // Monto mínimo
  maxInvestment   Decimal         @db.Decimal(12, 2) // Monto máximo
  totalCapacity   Decimal         @db.Decimal(15, 2) // Capacidad total del contrato
  currentRaised   Decimal         @db.Decimal(15, 2) @default(0) // Monto recaudado
  
  // Partes del contrato
  generator       String          // Generador que vende la energía
  generatorLocation String?       // Ubicación del generador
  buyer           String          // Empresa que compra la energía
  buyerIndustry   String          // Industria del comprador
  
  // Información energética
  energyType      EnergyType      @default(SOLAR)
  energyAmount    Decimal         @db.Decimal(12, 2) // Cantidad de energía (MWh)
  co2Emissions    Decimal         @db.Decimal(10, 2) // Toneladas de CO2 evitadas
  
  // Términos del contrato
  termMonths      Int             // Plazo en meses
  startDate       DateTime?       // Fecha de inicio
  endDate         DateTime?       // Fecha de fin
  
  // Estado
  status          ContractStatus  @default(DRAFT)
  
  // Tipos específicos
  contractType    String?         // "Infraestructura", "Liquidez"
  contractSubtype String?         // "Proyecto solar", "Smart grids", etc.
  
  // Metadata
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?         // ID del admin que creó
  
  // Relaciones
  documents       ContractDocument[]
  investments     Investment[]
  
  @@index([status])
  @@index([energyType])
}

model ContractDocument {
  id          String   @id @default(cuid())
  contractId  String
  
  name        String   // Nombre del documento
  type        String   // Tipo: "contract", "certificate", "technical", "other"
  url         String   // URL del archivo
  size        Int?     // Tamaño en bytes
  
  uploadedAt  DateTime @default(now())
  
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  @@index([contractId])
}

model Investment {
  id          String          @id @default(cuid())
  userId      String
  contractId  String
  
  amount      Decimal         @db.Decimal(15, 2)
  status      InvestmentStatus @default(PENDING)
  
  // Datos calculados
  expectedReturn Decimal?     @db.Decimal(15, 2)
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  confirmedAt DateTime?
  
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([contractId])
  @@index([status])
}

// ============================================
// ENUMS ADICIONALES
// ============================================

enum ContractStatus {
  DRAFT       // Borrador, no visible para usuarios
  ACTIVE      // Activo, aceptando inversiones
  FUNDED      // Completamente financiado
  IN_PROGRESS // En ejecución
  COMPLETED   // Contrato finalizado
  CANCELLED   // Cancelado
}

enum EnergyType {
  SOLAR          // Energía Solar Fotovoltaica
  WIND_ONSHORE   // Energía Eólica Onshore
  WIND_OFFSHORE  // Energía Eólica Offshore
  HYDRO          // Hidroeléctrica
  BIOMASS        // Biomasa
  GEOTHERMAL     // Geotérmica
  HYBRID         // Híbrido
  SOLAR_DEFAULT  // Alias para retrocompatibilidad
}

enum InvestmentStatus {
  PENDING     // Pendiente de confirmación
  CONFIRMED   // Confirmada
  CANCELLED   // Cancelada
  REFUNDED    // Reembolsada
}

