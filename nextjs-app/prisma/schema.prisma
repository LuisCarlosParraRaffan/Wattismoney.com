// Wattismoney - Schema de Base de Datos
// Fase inicial: Registro, Autenticación y KYC
// Este schema es extensible para añadir más modelos en el futuro

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTENTICACIÓN (Compatible con Auth.js v5)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // Para login con credentials
  
  // Datos personales
  firstName     String?
  lastName      String?
  phone         String?
  dateOfBirth   DateTime?
  nationality   String?
  
  // Perfil extendido
  avatarUrl     String?
  bio           String?   @db.Text
  address       String?
  city          String?
  country       String?
  preferredLanguage String? @default("es")
  profilePublic Boolean   @default(false)
  
  // Estado de la cuenta
  role          UserRole  @default(INVESTOR)
  status        UserStatus @default(PENDING_EMAIL_VERIFICATION)
  
  // Perfil de inversor (del quiz)
  investorProfile InvestorProfile?
  
  // Gamificación
  points        Int       @default(0)
  level         Int       @default(1)
  levelName     String?   // "Pionero", "Magnate Solar", etc.
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  // Relaciones
  accounts      Account[]
  sessions      Session[]
  kycDocuments  KycDocument[]
  investments   Investment[]
  sellerListings SecondaryListing[] @relation("SellerListings")
  buyerListings  SecondaryListing[] @relation("BuyerListings")
  badges        UserBadge[]
  wallet        Wallet?
  transactions  Transaction[]
  
  // Índices para búsquedas frecuentes
  @@index([email])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// KYC (Know Your Customer)
// ============================================

model KycDocument {
  id            String          @id @default(cuid())
  userId        String
  
  // Tipo de documento
  documentType  DocumentType
  documentNumber String?
  
  // Archivos subidos
  frontImageUrl String?
  backImageUrl  String?
  selfieUrl     String?
  proofOfResidenceUrl String?
  
  // Estado de verificación
  status        KycStatus       @default(PENDING)
  rejectionReason String?
  
  // Metadata
  submittedAt   DateTime        @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?         // ID del admin que revisó
  expiresAt     DateTime?       // Fecha de expiración del documento
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

model InvestorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  
  // Respuestas del quiz
  investmentGoal    String?  // "passive_income", "capital_growth", "diversification", "environmental_impact"
  investmentHorizon String?  // "less_1_year", "1_3_years", "3_5_years", "more_5_years"
  riskTolerance     String?  // "very_conservative", "conservative", "moderate", "aggressive"
  initialInvestment String?  // "less_1000", "1000_5000", "5000_20000", "more_20000"
  
  // Perfil calculado (legacy)
  profileType       ProfileType @default(MODERATE)
  
  // Perfil determinado por AI
  aiRiskProfile     String?   // "VISIONARIO" | "ACELERADOR" | "ESTABILIZADOR"
  aiConfidence      Float?    // 0.0 - 1.0
  aiReasons         String[]  // Array de razones
  aiRecommendations String[]  // Recomendaciones de inversión
  quizCompletedAt   DateTime?
  
  // Límites de inversión
  monthlyLimit      Decimal?    @db.Decimal(12, 2)
  
  // Preferencias
  preferredProjectTypes String[] // ["solar", "wind", "hydro", "biomass"]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  INVESTOR      // Usuario inversor normal
  ADMIN         // Administrador de la plataforma
  SUPER_ADMIN   // Super administrador
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION  // Recién registrado, email no verificado
  PENDING_KYC                 // Email verificado, KYC pendiente
  KYC_IN_REVIEW               // KYC enviado, en revisión
  KYC_REJECTED                // KYC rechazado
  ACTIVE                      // Usuario completamente verificado
  SUSPENDED                   // Cuenta suspendida
  DEACTIVATED                 // Cuenta desactivada por el usuario
}

enum KycStatus {
  PENDING     // Documentos no subidos
  SUBMITTED   // Documentos enviados, pendiente de revisión
  IN_REVIEW   // En proceso de revisión
  APPROVED    // Aprobado
  REJECTED    // Rechazado
  EXPIRED     // Documentos expirados
}

enum DocumentType {
  DNI         // Documento Nacional de Identidad (España)
  NIE         // Número de Identidad de Extranjero (España)
  PASSPORT    // Pasaporte
  DRIVERS_LICENSE
}

enum ProfileType {
  VERY_CONSERVATIVE
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

// ============================================
// CONTRATOS / OPORTUNIDADES DE INVERSIÓN
// ============================================

model Contract {
  id              String          @id @default(cuid())
  
  // Información básica
  name            String          // Nombre del contrato
  description     String?         @db.Text
  imageUrl        String?         // Fotografía promocional
  
  // Rentabilidad
  annualReturn    Decimal         @db.Decimal(5, 2)  // Rentabilidad anual (%)
  
  // Límites de inversión
  minInvestment   Decimal         @db.Decimal(12, 2) // Monto mínimo
  maxInvestment   Decimal         @db.Decimal(12, 2) // Monto máximo
  totalCapacity   Decimal         @db.Decimal(15, 2) // Capacidad total del contrato
  currentRaised   Decimal         @db.Decimal(15, 2) @default(0) // Monto recaudado
  
  // Partes del contrato
  generator       String          // Generador que vende la energía
  generatorLocation String?       // Ubicación del generador
  buyer           String          // Empresa que compra la energía
  buyerIndustry   String          // Industria del comprador
  
  // Información energética
  energyType      EnergyType      @default(SOLAR)
  energyAmount    Decimal         @db.Decimal(12, 2) // Cantidad de energía (MWh)
  co2Emissions    Decimal         @db.Decimal(10, 2) // Toneladas de CO2 evitadas
  
  // Términos del contrato
  termMonths      Int             // Plazo en meses
  startDate       DateTime?       // Fecha de inicio
  endDate         DateTime?       // Fecha de fin
  
  // Estado
  status          ContractStatus  @default(DRAFT)
  marketType      MarketType      @default(PRIMARY)
  
  // Tipos específicos
  contractType    String?         // "Infraestructura", "Liquidez"
  contractSubtype String?         // "Proyecto solar", "Smart grids", etc.
  paymentFrequency String?        @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ANNUAL"
  
  // Web3 / RWA Metadata
  treasuryWallet  String?         // Dirección EVM de tesorería/vault del proyecto
  tokenSymbol     String?         // Identificador simbólico RWA (ej. "WIM-SOL-01")
  
  // Metadata
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?         // ID del admin que creó
  
  // Relaciones
  documents       ContractDocument[]
  investments     Investment[]
  transactions    Transaction[]
  
  @@index([status])
  @@index([energyType])
  @@index([marketType])
}

model ContractDocument {
  id          String   @id @default(cuid())
  contractId  String
  
  name        String   // Nombre del documento
  type        String   // Tipo: "contract", "certificate", "technical", "other"
  url         String   // URL del archivo
  size        Int?     // Tamaño en bytes
  
  uploadedAt  DateTime @default(now())
  
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  @@index([contractId])
}

model Investment {
  id          String          @id @default(cuid())
  userId      String
  contractId  String
  
  amount      Decimal         @db.Decimal(15, 2)
  status      InvestmentStatus @default(PENDING)
  
  // Método de pago e información de origen
  paymentRail PaymentRail     @default(INTERNAL_WALLET)
  currency    String          @default("USD")
  txHash      String?         // Hash on-chain si se pagó directamente con Crypto
  
  // Datos calculados
  expectedReturn Decimal?     @db.Decimal(15, 2)
  accruedYield   Decimal      @db.Decimal(15, 2) @default(0)
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  confirmedAt DateTime?
  
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  listing     SecondaryListing?
  transactions Transaction[]
  
  @@index([userId])
  @@index([contractId])
  @@index([status])
}

// ============================================
// BILLETERA HÍBRIDA (FIAT + CRYPTO) Y LIBRO MAYOR
// ============================================

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  
  // Saldos equivalentes en USD
  fiatBalance       Decimal  @db.Decimal(15, 2) @default(0) // Disponible en Fiat (USD)
  cryptoBalanceUsdc Decimal  @db.Decimal(15, 6) @default(0) // Disponible en Stablecoins (USDC/USDT)
  lockedBalance     Decimal  @db.Decimal(15, 2) @default(0) // Retenido en retiros/órdenes pendientes
  totalDeposited    Decimal  @db.Decimal(15, 2) @default(0) // Total depositado histórico
  totalWithdrawn    Decimal  @db.Decimal(15, 2) @default(0) // Total retirado histórico
  totalYieldEarned  Decimal  @db.Decimal(15, 2) @default(0) // Rendimientos históricos recibidos
  
  // Configuración Web3 vinculada
  evmWalletAddress  String?
  preferredChainId  Int?     @default(137) // 137: Polygon, 8453: Base, 42161: Arbitrum, 1: Ethereum
  
  // Configuración bancaria para retiros Fiat
  bankName          String?
  bankAccountType   String?  // "Ahorros", "Corriente", "IBAN", "ACH"
  bankAccountNumber String?
  bankAccountHolder String?
  bankRoutingOrIban String?
  bankRoutingOrSwift String?
  bankCountry       String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  walletId          String
  
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  paymentRail       PaymentRail
  
  // Importes financieros (base USD)
  amount            Decimal           @db.Decimal(15, 2) // Monto bruto en USD
  fee               Decimal           @db.Decimal(15, 2) @default(0) // Comisión
  netAmount         Decimal           @db.Decimal(15, 2) // Monto neto en USD
  
  // Moneda / Token original
  currency          String            @default("USD") // "USD", "EUR", "COP", "MXN", "USDC", "USDT", "ETH"
  originalAmount    Decimal?          @db.Decimal(18, 6)
  exchangeRate      Decimal?          @db.Decimal(18, 6) @default(1)
  
  // Trazabilidad Web3 / Blockchain
  txHash            String?           @unique
  chainId           Int?              // 1 (ETH), 137 (Polygon), 8453 (Base), 42161 (Arbitrum)
  networkName       String?           // "Polygon", "Base", "Arbitrum", "Ethereum"
  tokenSymbol       String?           // "USDC", "USDT", "ETH"
  tokenAddress      String?
  fromAddress       String?
  toAddress         String?
  
  // Trazabilidad Pasarelas Fiat (Stripe, Wompi, MercadoPago) y Transferencias Bancarias
  externalId        String?           // ID en Stripe / Wompi / MercadoPago
  externalReference String?           // Referencia externa alternativa
  bankReference     String?           // Número de comprobante / referencia bancaria
  receiptUrl        String?           // URL del comprobante de transferencia bancaria
  bankName          String?
  description       String?
  adminNotes        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  
  // Vínculos opcionales con contratos o inversiones
  contractId        String?
  investmentId      String?
  listingId         String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  contract          Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  investment        Investment?       @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([paymentRail])
}

// ============================================
// MERCADO SECUNDARIO
// ============================================

model SecondaryListing {
  id            String        @id @default(cuid())
  investmentId  String        @unique
  sellerId      String
  
  askingPrice   Decimal       @db.Decimal(15, 2)
  originalAmount Decimal      @db.Decimal(15, 2)
  commission    Decimal       @db.Decimal(15, 2) // 3% para Wattismoney
  
  status        ListingStatus @default(ACTIVE)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  soldAt        DateTime?
  buyerId       String?
  
  investment    Investment    @relation(fields: [investmentId], references: [id])
  seller        User          @relation("SellerListings", fields: [sellerId], references: [id])
  buyer         User?         @relation("BuyerListings", fields: [buyerId], references: [id])
  
  @@index([sellerId])
  @@index([status])
}

// ============================================
// ENUMS ADICIONALES
// ============================================

enum ContractStatus {
  DRAFT       // Borrador, no visible para usuarios
  ACTIVE      // Activo, aceptando inversiones
  FUNDED      // Completamente financiado
  IN_PROGRESS // En ejecución
  COMPLETED   // Contrato finalizado
  CANCELLED   // Cancelado
}

enum EnergyType {
  SOLAR          // Energía Solar Fotovoltaica
  WIND_ONSHORE   // Energía Eólica Onshore
  WIND_OFFSHORE  // Energía Eólica Offshore
  HYDRO          // Hidroeléctrica
  BIOMASS        // Biomasa
  GEOTHERMAL     // Geotérmica
  HYBRID         // Híbrido
  SOLAR_DEFAULT  // Alias para retrocompatibilidad
}

enum InvestmentStatus {
  PENDING     // Pendiente de confirmación
  CONFIRMED   // Confirmada
  CANCELLED   // Cancelada
  REFUNDED    // Reembolsada
  SOLD        // Vendida en mercado secundario
}

enum MarketType {
  PRIMARY     // Mercado Primario
  SECONDARY   // Mercado Secundario
}

enum ListingStatus {
  ACTIVE      // Disponible para compra
  SOLD        // Vendida
  CANCELLED   // Cancelada por vendedor
}

enum TransactionType {
  DEPOSIT_FIAT
  DEPOSIT_CRYPTO
  WITHDRAWAL_FIAT
  WITHDRAWAL_CRYPTO
  INVESTMENT_PRIMARY
  SECONDARY_PURCHASE
  SECONDARY_SALE
  YIELD_DISTRIBUTION
  REFUND
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum PaymentRail {
  INTERNAL_WALLET
  STRIPE
  LATAM_GATEWAY
  BANK_TRANSFER
  WEB3_DIRECT
}

// ============================================
// GAMIFICACIÓN - INSIGNIAS
// ============================================

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique // "Early Investor", etc.
  description String?
  icon        String   // Material Symbol icon name
  color       String   // Gradient color: "yellow", "green", "blue", "purple"
  category    String?  // "investment", "risk", "innovation"
  pointsValue Int      @default(0) // XP que otorga al asignar
  
  createdAt   DateTime @default(now())
  
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  awardedBy String?  // Admin ID que la otorgó
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}
